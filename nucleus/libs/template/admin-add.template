<h2>{%text(_ADD_ADDTO)%} '{%bloglink%}'</h2>

{%init%}
<link rel="stylesheet" type="text/css" href="styles/tabs.css" />
<script type="text/javascript" src="javascript/tabs.js"></script>
<script type="text/javascript" src="javascript/numbercheck.js"></script>
<script type="text/javascript" src="javascript/edit_date.js"></script>
<script type="text/javascript" src="javascript/edit_state.js"></script>
{%ifautosave()%}<script type="text/javascript" src="javascript/xmlhttprequest.js"></script>{%endif%}

<form id="addform" method="post" action="index.php" >

	<input type="hidden" name="action" value="additem" />
	<input name="blogid" value="{%blogid%}" type="hidden" />
	<input type="hidden" name="draftid" value="0" />
	{%ticket%}

        <div class="form-header">
                <div class="form-header-actions">
                        <input tabindex="{%tabindex(1,1)%}" type="submit" value="{%text(_ADD_ADDITEM)%}"
                                onclick="return checkSubmit();" />
                        {%ifautosave()%}
                        <input tabindex="{%tabindex(1,1)%}" type="button" name="autosavenow" value="{%text(_AUTOSAVEDRAFT_NOW)%}"
                                onclick="autoSaveDraft();" />
                        {%endif%}
                </div>
        </div>

        <div class="title-input-wrapper">
                <input 
                        {%jsinput(title)%}
                        tabindex="10"
                        maxlength="160"
                        value="{%contents(title)%}"
                        placeholder="{%text(_ADD_TITLE)%}"
                        class="input-title"
                />
        </div>

<div class="item-add-tabs">
	<ul class="tab-nav">
		<li class="active"><a href="#tab_body" tabindex="300">{%text(_EDIT_TAB_BODY)%}</a></li>
		<li><a href="#tab_more" tabindex="310">{%text(_EDIT_TAB_MORE)%}</a></li>
		<li><a href="#tab_options" tabindex="320">{%text(_ADMIN_EDIT_TAB_SAVE_AND_OPTTIONS)%}</a></li>
	</ul>

	<div class="tab-content">
	<div id="tab_body" class="tab-pane active">

	<table>
	<tr class="body">
		<td>
			{%text(_ADD_BODY)%} {%helplink(additem)%}
		</td>
		<td>
			{%jsbuttonbar(media+preview)%}
			<textarea
				{%jsinput(body)%}
				tabindex="20"
				cols="60"
				rows="15">{%contents(body)%}</textarea>
		</td>
	</tr>
		</table>
	</div>

	<div id="tab_more" class="tab-pane">
		<table>

	<tr class="more">
		<td>{%text(_ADD_MORE)%} {%helplink(extended)%}
		</td>
		<td>
		<div id="moreforms">
			{%jsbuttonbar(media+preview)%}
			<textarea 
				{%jsinput(more)%}
				tabindex="70"
				cols="60"
				rows="15"
				>{%contents(more)%}</textarea>
		</div>
		<a href="#" id="openmore" onclick="return false;">{%text(_EDITTEMPLATE_EMPTY)%}</a>
		</td>
	</tr>
		</table>
	</div>

	<div id="tab_options" class="tab-pane">
		<table>
	<tr>
		<th colspan="2">{%text(_ADD_CREATENEW)%}</th>
	</tr>
	<tr>
		<td>{%text(_ADD_CATEGORY)%}</td>
		<td>{%categories(40)%}</td>
	</tr>
	{%ifautosave()%}
	<tr>
		<td>{%text(_AUTOSAVEDRAFT)%}</td>
		<td><span id="info">{%text(_AUTOSAVEDRAFT_NOTYETSAVED)%}</span></td>
	</tr>{%endif%}
<tr>
    <th colspan="2">{%text(_EDIT_SECTION_PUBLIC_STATE)%}</th>
</tr>
    <tr>
        <td>{%text(_ADD_STATUS)%}</td>
        <td>{%settabindex(41)%}
            <input name="act_state" type="radio" id="state_public"   value="public"   checked='checked' tabindex="{%tabindex(0)%}" onclick="checked_act_draft(false, this);" /><label for="state_public">{%text(_ADD_PUBLIC)%}</label>
            <span class="is-hidden">
            <input name="act_state" type="radio" id="state_unpublic" value="unpublic" tabindex="{%tabindex(0)%}" onclick="checked_act_draft(false, this);" /><label for="state_unpublic" >{%text(_ADD_UNPUBLIC)%}</label>
            </span>
            <input name="act_state" type="radio" id="state_draft"    value="draft"       tabindex="{%tabindex(0)%}" onclick="checked_act_draft(true, this);" /><label for="state_draft" >{%text(_ADD_DRAFT)%}</label>
{%iftext(_ENABLE_FEATURE_ITEM_TERM, 1)%}
            <div class="field-note">{%text(_ADD_PUBLIC_TERM)%}
                <div class="indent"><input name="public_enable_term_start" type="checkbox" id="public_enable_term_start" value="1" tabindex="{%tabindex()%}" />
                                    <label for="public_enable_term_start">{%text(_ADD_PUBLIC_TERM_START)%}</label> : {%public_date_time_picker1%}</div>
                <div class="indent"><input name="public_enable_term_end" type="checkbox" id="public_enable_term_end" value="1" tabindex="{%tabindex()%}" />
                                    <label for="public_enable_term_end">{%text(_ADD_PUBLIC_TERM_END)%}</label> : {%public_date_time_picker2%}</div>
                <div class="indent">{%text(_ITEM_ADDEDITTEMPLATE_FORMAT)%}{%text(_ADD_PUBLIC_DATE_FORMAT_DESC)%}</div>
                <div class="indent">{%text(_ADD_PUBLIC_TERM_DESC)%}</div>
            </div>
{%endif%}
        </td>
    </tr>


	<tr>
		<td>{%text(_ADD_DATETIME)%}</td>
		<td>{%copytabindex(,1)%}
			<input name="actiontype" value="addnow" type="radio" checked='checked' id="act_now" tabindex="{%tabindex(0,0)%}"
             onclick="checked_act_draft(false, this);" /><label for="act_now">{%text(_ADD_ADDNOW)%}</label>
{%settabindex(70)%}{%copytabindex()%}{%inctabindex()%}
			<br />
			<input name="actiontype" value="addfuture" type="radio" id="act_future" tabindex="{%tabindex(0,0)%}"
             onclick="checked_act_draft(false, this);" /><label for="act_future" >{%text(_ADD_ADDLATER)%}</label> {%helplink(future)%}
			<div class="indent">
				{%date_time_picker%}
				{%ifblogsetting(ballowpast,0)%}
					<br />
					{%text(_ADD_NOPASTDATES)%}
				{%endif%}
			</div>
			<input name="actiontype" tabindex="{%tabindex(0,0)%}" value="adddraft" type="radio" id="act_draft"
             onclick="checked_act_draft(true, this);" /><label for="act_draft">{%text(_ADD_ADDDRAFT)%}</label> {%helplink(draft)%}
		</td>
	</tr>
{%ifblogsetting(bcomments)%}
<tr>
    <th colspan="2">{%text(_EDIT_SECTION_COMMENTS)%}</th>
</tr>
    <tr>
		<td>{%text(_ADD_DISABLE_COMMENTS)%}</td>
		<td>
			<input name="closed" type="radio" tabindex="30" value="0" checked="checked" id="closed_no" /><label for="closed_no">{%text(_SETTINGS_ENABLED)%}</label>
			<input name="closed" type="radio" tabindex="30" value="1" id="closed_yes" /><label for="closed_yes">{%text(_SETTINGS_DISABLED)%}</label>
		</td>
    </tr>
{%endif%}
<tr>
    <th colspan="2">{%text(_EDIT_SECTION_OPTIONS)%}</th>
</tr>
	<tr>
		<td>{%settabindex(100)%}{%text(_ADD_PLUGIN_EXTRAS)%}</td>
		<td>
			{%pluginextras%}
		</td>
	</tr>
{%itemoptions%}	
    <tr>
		<td>{%text(_SUBMIT)%}</td>
		<td>
			<input tabindex="{%tabindex(1,1)%}" type="submit" value="{%text(_ADD_ADDITEM)%}" 
				onclick="return checkSubmit();" />
			{%ifautosave()%}
			<input tabindex="{%tabindex(1,1)%}" type="button" name="autosavenow" value="{%text(_AUTOSAVEDRAFT_NOW)%}"
				onclick="autoSaveDraft();" />
			{%endif%}
		</td>
	</tr>
</table>
	</div>

        <div id="tab_preview" class="contentblock is-hidden">
                <table>
                <tr id="edit" class="is-hidden">
                        <td>{%text(_ADD_PREVIEW)%}</td>
                        <td><b><span id="prevtitle">&#160;</span></b><br />
                                <span id="prevbody">&#160;</span><br />
				<span id="prevmore">&#160;</span><br />
			</td>
		</tr>
		</table>
	</div>
	</div><!-- .tab-content -->
</div><!-- .item-add-tabs -->
</form>



{%ifautosave()%}
<script type="text/javascript">
	var xmlhttprequest = new Array();
	xmlhttprequest[0] = createHTTPHandler(); // AutoDraft handler
	xmlhttprequest[1] = createHTTPHandler(); // UpdateTicket handler
	var seconds = now(); // Last AutoDraft time
	var checks = 0; // Number of checks since last AutoDraft
	var addform = document.getElementById('addform'); // The form id
	var goal = document.getElementById('info'); // The html div id where 'Last saved: date time' must come
	var goalurl = '../action.php'; // The PHP file where the content must be posted to
	var lastsavedtext = '{%text(_AUTOSAVEDRAFT_LASTSAVED)%}'; // The language variable for 'Last saved'
	var formtype = 'add'; // Add or edit form
</script>	
{%endif%}

<script type="text/javascript">
// datetime reset functions
function date_currenttime_reset( )
{
    edit_form_change_date_ByValue( new Array(
		 "{%currenttime(year)%}", "{%currenttime(mon)%}", "{%currenttime(mday)%}",
         "{%currenttime(hours)%}", "{%currenttime(minutes)%}" ) );
}
if(!jQuery('#inputmore').val()) {
	jQuery('div#moreforms').hide();
	jQuery('#openmore').show();
	jQuery('#openmore').click(function(){
		jQuery('div#moreforms').show();
		jQuery('#openmore').hide();
	});
}
else {
	jQuery('#openmore').hide();
}
</script>
