# Nucleus CMS Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control

# =============================================================================
# Application Settings
# =============================================================================

# Debug mode (true/false)
# When true: displays all errors, enables debug features
# When false: hides errors from users (recommended for production)
APP_DEBUG=false

# Application environment (local, staging, production)
APP_ENV=production

# =============================================================================
# Future expansion (reserved for dotenv migration)
# =============================================================================

# Database settings (future use - currently in config.php)
# DB_HOST=localhost
# DB_USER=nucleus
# DB_PASSWORD=
# DB_DATABASE=nucleus
# DB_PREFIX=
# DB_DRIVER=mysql

# Path settings (future use - currently in config.php)
# DIR_NUCLEUS=/path/to/nucleus/
# DIR_MEDIA=/path/to/media/
# DIR_SKINS=/path/to/skins/
